<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The app loads https://www.conz.co.zw (capacitor.config.ts,
     cleartext: false) and talks to Supabase / Paynow over HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
