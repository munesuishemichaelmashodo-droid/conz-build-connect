<?xml version="1.0" encoding="utf-8"?>
<!-- Audit M15: the WebView's localStorage holds the Supabase refresh token.
     Exclude everything from cloud backup and device-to-device transfer
     (Android 12+). allowBackup="false" covers older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
